{
  "framework": null,
  "functions": {
    "api/index.go": { "maxDuration": 60 },
    "api/cron/scrape/index.go": { "maxDuration": 60 },
    "api/cron/digest/index.go": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/scrape", "schedule": "0 3 * * *" },
    { "path": "/api/cron/digest", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
