# Root-level env, read by docker-compose.prod.yml (compose variable
# substitution + the Caddyfile). Not used by local `docker compose up`
# with the base docker-compose.yml — that one needs no domain.
#
# Copy to .env, fill in, then deploy with:
#   docker compose -f docker-compose.prod.yml up --build -d

# Public domain serving the frontend. Must already point (A/AAAA record)
# at this host before starting Caddy, or the Let's Encrypt challenge fails.
FRONTEND_DOMAIN=app.your-domain.example

# Public domain serving the backend API. Also needs its own DNS record.
BACKEND_DOMAIN=api.your-domain.example

# Address Let's Encrypt uses for expiry/problem notices about the certs above.
ACME_EMAIL=you@your-domain.example
