# Copy to .env and fill in. Required vars are checked at startup (missing
# DATABASE_CONNECTION or SECRET_KEY will fail fast with a clear error).
#
# No quotes around values — this file is also loaded as Docker's env_file,
# which (unlike godotenv, used for local `go run`) takes everything after `=`
# literally, quotes included. A quoted value here breaks the connection
# string inside the container.

# --- Required ---

# Postgres connection string (Supabase pooler URL, or any Postgres 14+ instance).
DATABASE_CONNECTION=postgresql://user:password@host:5432/dbname

# HMAC signing key for access-token JWTs. Use a long random value
# (e.g. `openssl rand -base64 48`) — do not reuse a weak/guessable key in prod.
SECRET_KEY=change-me-to-a-long-random-value

# --- Recommended for a real deployment ---

# Frontend origin allowed by CORS. Defaults to http://localhost:5173 if unset,
# which is wrong for any deployed environment.
ALLOWED_ORIGIN=https://your-frontend-domain.example

# Set to "true" once the app is served over HTTPS, so refresh cookies get the
# Secure flag. Defaults to false (cookie sent over plain HTTP) if unset.
COOKIE_SECURE=true

# Set to "none" if frontend and backend are on different sites (e.g. frontend
# on Vercel, backend on its own domain) and you rely on cross-site cookies
# (also requires COOKIE_SECURE=true). Defaults to Lax.
COOKIE_SAME_SITE=none

# Port the HTTP server listens on. Defaults to 8090 if unset.
# PORT=8090

# Resend API key for the email digest feature. If unset, digest emails are
# skipped (logged, not sent) — matching runs still record as sent.
RESEND_API_KEY=re_xxx

# Verified sending domain in Resend. Defaults to the shared Resend sandbox
# address (onboarding@resend.dev), which is fine for testing but not prod.
# RESEND_FROM_ADDRESS=jobs@your-domain.example

# Publicly reachable base URL of this backend (no trailing slash). Used to build
# the one-click unsubscribe link in digest emails. Defaults to
# http://localhost:8090, which is unreachable from a recipient's inbox — set
# this for any deployment that actually sends digest emails.
# PUBLIC_BACKEND_URL=https://api.your-domain.example

# OpenRouter API key (openrouter.ai/keys) — used for resume field extraction
# and cover-letter generation. Free tier, sign in with Google/GitHub/email, no
# phone verification.
OPENROUTER_API_KEY=

# Chat model for extraction/generation — must be a ":free" model to stay free.
# OpenRouter's free lineup changes over time; if the default below stops
# working, pick a current one from openrouter.ai/models?max_price=0.
# Defaults to minimax/minimax-m2.7:free.
# OPENROUTER_MODEL=minimax/minimax-m2.7:free

# Jina AI API key (jina.ai/api-dashboard) — used for resume/job embeddings.
# Free, no card required.
JINA_API_KEY=

# Embedding model for resume/job match scoring — must stay a 768-dim model to
# match the `vector(768)` columns in migrations/000002_add_embeddings.up.sql.
# Defaults to jina-embeddings-v2-base-en, which is 768-dim.
# JINA_EMBED_MODEL=jina-embeddings-v2-base-en

# Shared secret Vercel Cron Jobs send back as "Authorization: Bearer
# $CRON_SECRET" — required only when deploying backend/api/cron/* to Vercel, so
# the scrape/digest endpoints can't be triggered by an outside request hitting
# their public URL. Not used by the self-hosted binary (main.go), which runs
# its own in-process scheduler instead.
# CRON_SECRET=

# --- Optional: local dev / test only ---

# Separate Postgres database used by `go test`. MUST be a different database
# than DATABASE_CONNECTION — tests DROP TABLE ... CASCADE on it.
TEST_DATABASE_CONNECTION=postgresql://user:password@host:5432/dbname_test
